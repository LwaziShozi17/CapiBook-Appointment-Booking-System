{
  "title": "CapiBook — Application Overview",
  "uid": "capibook-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Application Health",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "up{job=\"capibook-backend\"}",
          "legendFormat": "Backend"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "green", "value": 1 }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"CapiBook\"}[1m])) by (uri, method)",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Error Rate (4xx+5xx)",
      "type": "timeseries",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"CapiBook\",status=~\"4..|5..\"}[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Request Latency (p95, ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"CapiBook\"}[5m])) by (le, uri)) * 1000",
          "legendFormat": "p95 {{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM Memory Used",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"CapiBook\",area=\"heap\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"CapiBook\",area=\"heap\"}",
          "legendFormat": "Heap Max"
        }
      ]
    },
    {
      "id": 6,
      "title": "Appointments Booked (total)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "capibook_appointments_booked_total{application=\"CapiBook\"}",
          "legendFormat": "Booked"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 7,
      "title": "Appointments Cancelled (total)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 16, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "capibook_appointments_cancelled_total{application=\"CapiBook\"}",
          "legendFormat": "Cancelled"
        }
      ]
    },
    {
      "id": 8,
      "title": "Appointments Confirmed (total)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 16, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "capibook_appointments_confirmed_total{application=\"CapiBook\"}",
          "legendFormat": "Confirmed"
        }
      ]
    },
    {
      "id": 9,
      "title": "Appointments Completed (total)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "capibook_appointments_completed_total{application=\"CapiBook\"}",
          "legendFormat": "Completed"
        }
      ]
    },
    {
      "id": 10,
      "title": "No-Shows (total)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 16, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "capibook_appointments_no_show_total{application=\"CapiBook\"}",
          "legendFormat": "No-Show"
        }
      ]
    },
    {
      "id": 11,
      "title": "Booking Throughput (bookings/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(capibook_appointments_booked_total{application=\"CapiBook\"}[1m]) * 60",
          "legendFormat": "Bookings/min"
        },
        {
          "expr": "rate(capibook_appointments_cancelled_total{application=\"CapiBook\"}[1m]) * 60",
          "legendFormat": "Cancellations/min"
        }
      ]
    },
    {
      "id": 12,
      "title": "DB Connection Pool",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"CapiBook\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"CapiBook\"}",
          "legendFormat": "Idle"
        },
        {
          "expr": "hikaricp_connections_max{application=\"CapiBook\"}",
          "legendFormat": "Max"
        }
      ]
    }
  ]
}
